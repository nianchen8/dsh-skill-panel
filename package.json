{
  "name": "dsh-skill-panel",
  "version": "1.3.0",
  "description": "Skill management panel for the dsh web app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nianchen8/dsh-skill-panel.git"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.6",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
